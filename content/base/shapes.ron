// Shapes: one geometry each, read by everything — the physics (collision,
// mass, inertia, drag), traffic (bounds), the renderer (the wireframe) and
// outfitting (mounts). Built from `hull` points (their convex hull), or later
// from a Blender export (`gltf: "file.glb"`). Points are in units of `scale`
// metres; −Z forward, +Y up. See docs/content.md.
//
// loops: detail lines drawn on the hull (hatches, nozzle outlines).
// nodes: named places on it — `mount_<slot>` (where modules attach),
// `nozzle_<name>` (thrusters built in; `dir` is where the exhaust goes),
// `gear_<name>` (landing contacts), `dock_<name>`, `cockpit`.
[
    (
        key: "shape.cobra",
        // A Cobra Mk III-style trader.
        scale: 20.0,
        hull: [
            (-0.35, 0.0, -1.0), (0.35, 0.0, -1.0),
            (-0.35, -0.12, -0.7), (0.35, -0.12, -0.7),
            (-0.45, 0.28, 0.8), (0.45, 0.28, 0.8),
            (-1.3, -0.02, 0.8), (1.3, -0.02, 0.8),
            (-0.5, -0.22, 0.8), (0.5, -0.22, 0.8),
            (-0.3, 0.2, 0.0), (0.3, 0.2, 0.0),
        ],
        loops: [
            [(-0.1, -0.1, 0.8), (-0.35, -0.1, 0.8), (-0.35, 0.12, 0.8), (-0.1, 0.12, 0.8)],
            [(0.1, -0.1, 0.8), (0.35, -0.1, 0.8), (0.35, 0.12, 0.8), (0.1, 0.12, 0.8)],
        ],
        nodes: [
            // The main drive: two engines on the rear plate.
            (name: "nozzle_main_left", at: (-0.225, 0.01, 0.8), dir: (0.0, 0.0, 1.0)),
            (name: "nozzle_main_right", at: (0.225, 0.01, 0.8), dir: (0.0, 0.0, 1.0)),
            // Thruster quads at the four corners: one firing up, one outward,
            // one ahead (the nose's) or astern (the tail's). The fore and aft
            // pairs sit as far either side of the centre of mass (0.21 aft):
            // pushing straight, they don't turn the ship.
            (name: "nozzle_nose_left_up", at: (-0.3, 0.15, -0.34), dir: (0.0, 1.0, 0.0)),
            (name: "nozzle_nose_left_side", at: (-0.55, 0.0, -0.34), dir: (-1.0, 0.0, 0.0)),
            (name: "nozzle_nose_left_fore", at: (-0.3, 0.0, -0.95), dir: (0.0, 0.0, -1.0)),
            (name: "nozzle_nose_right_up", at: (0.3, 0.15, -0.34), dir: (0.0, 1.0, 0.0)),
            (name: "nozzle_nose_right_side", at: (0.55, 0.0, -0.34), dir: (1.0, 0.0, 0.0)),
            (name: "nozzle_nose_right_fore", at: (0.3, 0.0, -0.95), dir: (0.0, 0.0, -1.0)),
            (name: "nozzle_tail_left_up", at: (-0.9, 0.1, 0.75), dir: (0.0, 1.0, 0.0)),
            (name: "nozzle_tail_left_side", at: (-1.25, 0.0, 0.75), dir: (-1.0, 0.0, 0.0)),
            (name: "nozzle_tail_left_aft", at: (-0.9, 0.0, 0.8), dir: (0.0, 0.0, 1.0)),
            (name: "nozzle_tail_right_up", at: (0.9, 0.1, 0.75), dir: (0.0, 1.0, 0.0)),
            (name: "nozzle_tail_right_side", at: (1.25, 0.0, 0.75), dir: (1.0, 0.0, 0.0)),
            (name: "nozzle_tail_right_aft", at: (0.9, 0.0, 0.8), dir: (0.0, 0.0, 1.0)),
            // Belly lift, firing down, around the centre of mass.
            (name: "nozzle_lift_nose_left", at: (-0.3, -0.12, -0.3), dir: (0.0, -1.0, 0.0)),
            (name: "nozzle_lift_nose_right", at: (0.3, -0.12, -0.3), dir: (0.0, -1.0, 0.0)),
            (name: "nozzle_lift_tail_left", at: (-0.8, -0.15, 0.7), dir: (0.0, -1.0, 0.0)),
            (name: "nozzle_lift_tail_right", at: (0.8, -0.15, 0.7), dir: (0.0, -1.0, 0.0)),
            (name: "cockpit", at: (0.0, 0.15, -0.5), dir: (0.0, 0.0, -1.0)),
            // The landing gear: two legs aft, one under the nose.
            (name: "gear_left", at: (-0.35, -0.16, 0.4), dir: (0.0, -1.0, 0.0)),
            (name: "gear_right", at: (0.35, -0.16, 0.4), dir: (0.0, -1.0, 0.0)),
            (name: "gear_nose", at: (0.0, -0.11, -0.6), dir: (0.0, -1.0, 0.0)),
        ],
    ),
    (
        key: "shape.coriolis",
        // A Coriolis station: a cuboctahedron (every permutation of (±1, ±1, 0)),
        // unit size (drawn scaled to the station), its docking slot on +Y.
        scale: 1.0,
        hull: [
            (0.0, 1.0, 1.0), (0.0, 1.0, -1.0), (0.0, -1.0, 1.0), (0.0, -1.0, -1.0),
            (1.0, 0.0, 1.0), (-1.0, 0.0, 1.0), (1.0, 0.0, -1.0), (-1.0, 0.0, -1.0),
            (1.0, 1.0, 0.0), (1.0, -1.0, 0.0), (-1.0, 1.0, 0.0), (-1.0, -1.0, 0.0),
        ],
        loops: [
            [(-0.3, 1.0, -0.08), (0.3, 1.0, -0.08), (0.3, 1.0, 0.08), (-0.3, 1.0, 0.08)],
        ],
        nodes: [
            (name: "dock_slot", at: (0.0, 1.0, 0.0), dir: (0.0, 1.0, 0.0)),
        ],
    ),
]
