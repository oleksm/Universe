            (name: "nozzle_tail_right_aft", at: (0.9, 0.0, 0.8), dir: (0.0, 0.0, 1.0)),
            // Belly lift, firing down, around the centre of mass.
            (name: "nozzle_lift_nose_left", at: (-0.3, -0.12, -0.3), dir: (0.0, -1.0, 0.0)),
            (name: "nozzle_lift_nose_right", at: (0.3, -0.12, -0.3), dir: (0.0, -1.0, 0.0)),
