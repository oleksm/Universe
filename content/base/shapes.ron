// Shapes: one geometry each, read by everything — the physics (collision,
// mass, inertia, drag), traffic (bounds), the renderer (the wireframe) and
// outfitting (mounts). Built from `hull` points (their convex hull), or later
// from a Blender export (`gltf: "file.glb"`). Points are in units of `scale`
// metres; −Z forward, +Y up. See docs/content.md.
//
// loops: detail lines drawn on the hull (hatches, nozzle outlines).
// nodes: named places on it — `mount_<slot>` (where modules attach),
// `nozzle_<name>` (thrusters built in; `dir` is where the exhaust goes),
// `gear_<name>` (landing contacts), `dock_<name>`, `cockpit`.
[
    (
        key: "shape.cobra",
        // A Cobra Mk III-style trader.
        scale: 20.0,
        hull: [
            (-0.35, 0.0, -1.0), (0.35, 0.0, -1.0),
            (-0.35, -0.12, -0.7), (0.35, -0.12, -0.7),
            (-0.45, 0.28, 0.8), (0.45, 0.28, 0.8),
            (-1.3, -0.02, 0.8), (1.3, -0.02, 0.8),
            (-0.5, -0.22, 0.8), (0.5, -0.22, 0.8),
            (-0.3, 0.2, 0.0), (0.3, 0.2, 0.0),
        ],
        loops: [
            [(-0.1, -0.1, 0.8), (-0.35, -0.1, 0.8), (-0.35, 0.12, 0.8), (-0.1, 0.12, 0.8)],
            [(0.1, -0.1, 0.8), (0.35, -0.1, 0.8), (0.35, 0.12, 0.8), (0.1, 0.12, 0.8)],
        ],
        nodes: [
            (name: "nozzle_main_left", at: (-0.225, 0.01, 0.8), dir: (0.0, 0.0, 1.0)),
            (name: "nozzle_main_right", at: (0.225, 0.01, 0.8), dir: (0.0, 0.0, 1.0)),
            (name: "cockpit", at: (0.0, 0.15, -0.5), dir: (0.0, 0.0, -1.0)),
        ],
    ),
    (
        key: "shape.coriolis",
        // A Coriolis station: a cuboctahedron (every permutation of (±1, ±1, 0)),
        // unit size (drawn scaled to the station), its docking slot on +Y.
        scale: 1.0,
        hull: [
            (0.0, 1.0, 1.0), (0.0, 1.0, -1.0), (0.0, -1.0, 1.0), (0.0, -1.0, -1.0),
            (1.0, 0.0, 1.0), (-1.0, 0.0, 1.0), (1.0, 0.0, -1.0), (-1.0, 0.0, -1.0),
            (1.0, 1.0, 0.0), (1.0, -1.0, 0.0), (-1.0, 1.0, 0.0), (-1.0, -1.0, 0.0),
        ],
        loops: [
            [(-0.3, 1.0, -0.08), (0.3, 1.0, -0.08), (0.3, 1.0, 0.08), (-0.3, 1.0, 0.08)],
        ],
        nodes: [
            (name: "dock_slot", at: (0.0, 1.0, 0.0), dir: (0.0, 1.0, 0.0)),
        ],
    ),
]
