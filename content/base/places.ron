        ship_fuel: 60.0,
        works: [("recipe.farm", 8.0), ("recipe.artisans", 2.0), ("recipe.wells", 1.0), ("recipe.fuel_plant", 6.0)],
        sells: ["market.food", "market.water", "market.fuel", "market.textiles", "market.biologics", "market.luxuries", "market.art"],
        wants: ["market.machinery", "market.electronics", "market.computers", "market.medicine", "market.tools", "market.robots"],
    ),
    (
