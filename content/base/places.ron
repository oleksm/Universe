// Kinds of place in the economy (which a facility is follows from where it
// is: a station; a spaceport on an Earth-like world, a dry world, a cratered
// moon). population: thousands. ship_fuel: fuel kept for calling ships (t/day).
// Fuel (deuterium) is made where there's water: Earth-like worlds' seas and
// outposts' ice. Stations import it.
// works: (recipe, how many). sells / wants: what its market leans to where
// there's no economy behind it (beyond the gate network).
[
    (
        key: "place.station",
        label: "STATION",
        population: 25.0,
        ship_fuel: 200.0,
        works: [("recipe.factory", 2.0), ("recipe.fab", 2.0), ("recipe.pharma", 1.0), ("recipe.smelter", 1.0)],
        sells: ["market.machinery", "market.electronics", "market.computers", "market.robots", "market.tools", "market.medicine", "market.chemicals"],
        wants: ["market.fuel", "market.food", "market.water", "market.ores", "market.metals", "market.luxuries", "market.textiles", "market.biologics", "market.art"],
    ),
    (
        key: "place.farm",
