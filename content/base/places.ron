        sells: ["market.ores", "market.metals", "market.minerals", "market.chemicals", "market.fuel", "market.artifacts"],
        wants: ["market.food", "market.water", "market.machinery", "market.tools", "market.medicine", "market.robots", "market.luxuries"],
