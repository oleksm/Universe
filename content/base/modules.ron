// Modules: what hulls are fitted with. Every one a real thing: mass (kg),
// volume (m³), the power it draws working (W), a price (credits), a size
// class (1..4: it fits a slot at least as big). Thrust is a full-share
// nozzle's (N): a hull says each nozzle's share of its slot's module.
// See docs/content.md.
[
    // The base blocks every ship carries.
    (key: "power.fusion.s2", name: "FUSION PLANT S2", does: PowerPlant(output: 8.0e6), size: 2, mass: 3000.0, volume: 6.0, price: 18000.0),
    (key: "drive.torch.s2", name: "TORCH DRIVE S2", does: Drive(thrust: 1.35e6), size: 2, mass: 6000.0, volume: 14.0, power: 1.0e6, price: 42000.0),
    (key: "thrusters.quad.s2", name: "THRUSTER QUADS S2", does: Thrusters(thrust: 2.7e5), size: 2, mass: 1500.0, volume: 3.0, power: 2.0e5, price: 9000.0),
    (key: "tank.s3", name: "FUEL TANK 30 T", does: Tank(capacity: 30000.0), size: 3, mass: 2000.0, volume: 45.0, price: 4000.0),
    (key: "computer.fbw.s1", name: "FLIGHT COMPUTER", does: FlightComputer(turn_rate: 1.0, roll_rate: 1.8), size: 1, mass: 200.0, volume: 0.4, power: 5.0e4, price: 6000.0),
    (key: "transponder.s1", name: "TRANSPONDER", does: Transponder, size: 1, mass: 50.0, volume: 0.1, power: 1.0e3, price: 500.0),
    (key: "sensors.radar.s1", name: "RADAR 500 KM", does: Sensors(range: 500000.0), size: 1, mass: 300.0, volume: 0.8, power: 1.0e5, price: 7000.0),
    (key: "life.s2", name: "LIFE SUPPORT", does: LifeSupport, size: 2, mass: 1500.0, volume: 8.0, power: 2.0e5, price: 5000.0),
    // Specialised equipment.
    (key: "lift.belly.s2", name: "BELLY LIFT S2", does: Lift(thrust: 5.625e5), size: 2, mass: 2500.0, volume: 5.0, power: 3.0e5, price: 15000.0),
    (key: "rack.s3", name: "CARGO RACKS 20 T", does: Rack(capacity: 20000.0), size: 3, mass: 1500.0, volume: 30.0, price: 3000.0),
    (key: "hyperdrive.s2", name: "HYPERDRIVE S2", does: Hyperdrive, size: 2, mass: 4000.0, volume: 10.0, power: 1.5e6, price: 60000.0),
    (key: "gun.mass_driver.s1", name: "MASS DRIVER", does: Gun, size: 1, mass: 800.0, volume: 1.5, power: 5.0e4, price: 8000.0),
    (key: "laser.pulse.s1", name: "PULSE LASER", does: Laser, size: 1, mass: 1200.0, volume: 2.0, power: 2.5e6, price: 14000.0),
    (key: "mining.rig.s2", name: "MINING RIG", does: MiningRig, size: 2, mass: 2500.0, volume: 6.0, power: 5.0e5, price: 12000.0),
    (key: "nav.full.s1", name: "NAV COMPUTER", does: NavComputer(features: [Docking, Landing, Gate, Follow, Hyperdrive, Route]), size: 1, mass: 150.0, volume: 0.3, power: 2.0e4, price: 20000.0),
]
