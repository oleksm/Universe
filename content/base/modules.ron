    // radius (`link`), at light speed: the hypernet's towers.
    (key: "transceiver.station", brand: "brand.tallis", name: "TALLIS STATION TRANSCEIVER", does: Comm(capture: 1.0e9, link: 7.5e10, lag: 0.02, capacity: 100000.0), size: 4, mass: 20000.0, volume: 60.0, power: 1.0e6, price: 400000.0),
