// The Foundry Standards Office's register: the first standards (docs/standards.md).
// Every number here is invented unless its note says otherwise; the notes say what
// it's aimed at. Table parameters are keyed ROW.column (S.length_max).
[
    (
        key: "FSO/0.1/001",
        body: "body.fso",
        branch: "0.1",
        version: 1,
        title: "UNITS AND MEASURES",
        scope: "THE UNITS EVERY OTHER STANDARD STATES ITS FIGURES IN. NOT HOW THINGS ARE MEASURED (INSTRUMENTS).",
        status: Published,
        params: [
            (key: "length", value: Text("METRE"), unit: "m"),
            (key: "mass", value: Text("KILOGRAM; TONNE = 1000 KG"), unit: "kg"),
            (key: "time", value: Text("SECOND"), unit: "s"),
            (key: "force", value: Text("NEWTON"), unit: "N"),
            (key: "energy", value: Text("JOULE"), unit: "J"),
            (key: "power", value: Text("WATT"), unit: "W"),
            (key: "temperature", value: Text("KELVIN"), unit: "K"),
            (key: "angle", value: Text("RADIAN; DEGREES FOR PEOPLE"), unit: "rad"),
            (key: "voltage", value: Text("VOLT"), unit: "V"),
        ],
        text: "ONE SET OF UNITS, SO A FIGURE IN ONE STANDARD MEANS THE SAME IN THE NEXT. THE OLD METRIC SYSTEM, KEPT AS IT WAS.",
        licence: Open,
    ),
    (
        key: "FSO/3.1/001",
        body: "body.fso",
        branch: "3.1",
        version: 1,
        title: "VESSEL SIZE CLASSES",
        scope: "THE ENVELOPE A VESSEL OF EACH CLASS STAYS WITHIN, SO PORTS CAN LAY OUT FOR IT. NOT WHAT A VESSEL IS FOR.",
        status: Published,
        refs: ["FSO/0.1/001"],
        params: [
            (key: "S.length_max", value: Num(30.0), unit: "m", note: "INVENTED: A SHUTTLE OR A FIGHTER"),
            (key: "S.width_max", value: Num(20.0), unit: "m"),
            (key: "S.height_max", value: Num(12.0), unit: "m"),
            (key: "S.mass_max", value: Num(400.0), unit: "t", note: "LOADED"),
            (key: "M.length_max", value: Num(60.0), unit: "m", note: "INVENTED: A HAULER, A MINER"),
            (key: "M.width_max", value: Num(35.0), unit: "m"),
            (key: "M.height_max", value: Num(20.0), unit: "m"),
            (key: "M.mass_max", value: Num(2000.0), unit: "t"),
            (key: "L.length_max", value: Num(110.0), unit: "m", note: "INVENTED: A BIG WORKER (THE MC-07 IS 74 M)"),
            (key: "L.width_max", value: Num(60.0), unit: "m"),
            (key: "L.height_max", value: Num(35.0), unit: "m"),
            (key: "L.mass_max", value: Num(12000.0), unit: "t"),
            (key: "XL.length_max", value: Num(400.0), unit: "m", note: "INVENTED: CAPITAL SHIPS, BERTHED IN ORBIT ONLY"),
            (key: "XL.width_max", value: Num(200.0), unit: "m"),
            (key: "XL.height_max", value: Num(120.0), unit: "m"),
            (key: "XL.mass_max", value: Num(300000.0), unit: "t"),
        ],
        requires: [
            (subject: "ship.length", check: AtMost, param: "length_max", per: "class"),
            (subject: "ship.width", check: AtMost, param: "width_max", per: "class"),
            (subject: "ship.height", check: AtMost, param: "height_max", per: "class"),
            (subject: "ship.mass", check: AtMost, param: "mass_max", per: "class"),
        ],
        text: "A PORT CAN'T TAKE EVERY SHAPE. FOUR ENVELOPES, EACH A PAD OR BERTH SIZE: BUILD WITHIN ONE AND EVERY PORT WITH THAT SIZE CAN SET YOU DOWN. HEIGHT INCLUDES GEAR DOWN; MASS IS LOADED.",
        licence: Open,
    ),
    (
        key: "FSO/4.1/001",
        body: "body.fso",
        branch: "4.1",
        version: 1,
        title: "LANDING PADS AND BERTHS",
        scope: "THE PADS AND BERTHS A PORT OFFERS, BY VESSEL CLASS: SIZE, SPACING, WHAT THEY BEAR. NOT HOW TRAFFIC IS RUN.",
        status: Published,
        refs: ["FSO/3.1/001"],
        params: [
            (key: "S.side", value: Num(40.0), unit: "m", note: "INVENTED: A CLASS S ENVELOPE AND 5 M ROUND IT"),
            (key: "S.spacing", value: Num(60.0), unit: "m", note: "CENTRE TO CENTRE"),
            (key: "S.bears", value: Num(4000.0), unit: "kN", note: "A LOADED CLASS S AT 1 G, TWICE OVER"),
            (key: "M.side", value: Num(70.0), unit: "m", note: "TODAY'S PAINTED PADS"),
            (key: "M.spacing", value: Num(100.0), unit: "m"),
            (key: "M.bears", value: Num(40000.0), unit: "kN"),
            (key: "L.side", value: Num(120.0), unit: "m", note: "INVENTED: A CLASS L ENVELOPE AND 5 M ROUND IT"),
            (key: "L.spacing", value: Num(150.0), unit: "m", note: "TODAY'S PAD GRID"),
            (key: "L.bears", value: Num(240000.0), unit: "kN"),
            (key: "XL.side", value: Text("NONE: BERTHED IN ORBIT"), unit: ""),
        ],
        requires: [
            (subject: "ship.class", check: AtMost, param: "side", per: "pad"),
        ],
        text: "A PAD OF A CLASS TAKES A VESSEL OF THAT CLASS OR SMALLER. SPACING KEEPS NEIGHBOURS CLEAR AND LEAVES ROOM FOR A MISSED APPROACH.",
        licence: Open,
    ),
    (
        key: "FSO/6.1/001",
        body: "body.fso",
        branch: "6.1",
        version: 1,
        title: "VESSEL POWER BUS",
        scope: "THE POWER A SOCKET HANDS A MODULE: VOLTAGE, CURRENT CLASSES, CONNECTOR. NOT HOW IT'S MADE (THE PLANT).",
        status: Published,
        refs: ["FSO/0.1/001"],
        params: [
            (key: "voltage", value: Num(800.0), unit: "V", note: "INVENTED: DIRECT CURRENT, AS HEAVY VEHICLES USE"),
            (key: "tolerance", value: Range(720.0, 880.0), unit: "V"),
            (key: "A.current_max", value: Num(100.0), unit: "A", note: "80 KW"),
            (key: "B.current_max", value: Num(400.0), unit: "A", note: "320 KW"),
            (key: "C.current_max", value: Num(1600.0), unit: "A", note: "1.28 MW"),
            (key: "D.current_max", value: Num(6000.0), unit: "A", note: "4.8 MW"),
        ],
        requires: [
            (subject: "module.voltage", check: Equals, param: "voltage"),
            (subject: "module.current", check: AtMost, param: "current_max", per: "power_class"),
        ],
        text: "ONE VOLTAGE EVERYWHERE, SO ANY MODULE RUNS OFF ANY HULL'S SOCKET OF ITS CLASS.",
        licence: Open,
    ),
    (
        key: "FSO/2.1/001",
        body: "body.fso",
        branch: "2.1",
        version: 1,
        title: "HARDPOINT SOCKET",
        scope: "WHERE A TURRET, GUN OR LASER MOUNTS: WHAT IT MAY WEIGH, PUSH BACK WITH, DRAW, AND SWEEP. NOT WHAT IT FIRES.",
        status: Published,
        refs: ["FSO/0.1/001", "FSO/6.1/001"],
        params: [
            (key: "1.mass_max", value: Num(0.5), unit: "t", note: "INVENTED: SIZES AS TODAY'S SLOT SIZES 1-4"),
            (key: "1.recoil_max", value: Num(20.0), unit: "kN"),
            (key: "1.clearance", value: Text("1.5 X 2.0 X 1.2"), unit: "m"),
            (key: "1.power", value: Text("CLASS A"), unit: ""),
            (key: "2.mass_max", value: Num(2.0), unit: "t"),
            (key: "2.recoil_max", value: Num(80.0), unit: "kN"),
            (key: "2.clearance", value: Text("2.5 X 4.0 X 2.0"), unit: "m"),
            (key: "2.power", value: Text("CLASS B"), unit: ""),
            (key: "3.mass_max", value: Num(8.0), unit: "t"),
            (key: "3.recoil_max", value: Num(300.0), unit: "kN"),
            (key: "3.clearance", value: Text("4.0 X 6.0 X 3.0"), unit: "m"),
            (key: "3.power", value: Text("CLASS C"), unit: ""),
            (key: "4.mass_max", value: Num(30.0), unit: "t"),
            (key: "4.recoil_max", value: Num(1200.0), unit: "kN"),
            (key: "4.clearance", value: Text("7.0 X 10.0 X 5.0"), unit: "m"),
            (key: "4.power", value: Text("CLASS D"), unit: ""),
        ],
        requires: [
            (subject: "module.mass", check: AtMost, param: "mass_max", per: "size"),
            (subject: "module.recoil", check: AtMost, param: "recoil_max", per: "size"),
            (subject: "module.envelope", check: FitsWithin, param: "clearance", per: "size"),
            (subject: "module.power", check: Provides, param: "power", per: "size"),
        ],
        text: "A HULL VENDOR SAYS WHERE ITS HARDPOINTS ARE AND HOW BIG; A WEAPONS VENDOR BUILDS TO THE SIZE. CLEARANCE IS THE WHOLE SWEEP OF A TURNING TURRET, STOWED OR FIRING.",
        licence: Open,
    ),
    (
        key: "FSO/2.1/002",
        body: "body.fso",
        branch: "2.1",
        version: 1,
        title: "NOZZLE SOCKET",
        scope: "WHERE A DRIVE NOZZLE OR THRUSTER MOUNTS: THRUST IT MAY TAKE, FLANGE, FEED, PLUME KEEP-OUT. THE AXIS AND THRUST RANGE OF EACH ARE THE HULL VENDOR'S (ITS DATASHEET).",
        status: Published,
        refs: ["FSO/0.1/001", "FSO/6.1/001"],
        params: [
            (key: "1.thrust_max", value: Num(60.0), unit: "kN", note: "A THRUSTER QUAD"),
            (key: "1.flange", value: Num(0.5), unit: "m", note: "DIAMETER"),
            (key: "2.thrust_max", value: Num(400.0), unit: "kN"),
            (key: "2.flange", value: Num(1.2), unit: "m"),
            (key: "3.thrust_max", value: Num(1500.0), unit: "kN", note: "A DROVER'S MAIN NOZZLE (1.3 MN)"),
            (key: "3.flange", value: Num(2.5), unit: "m"),
            (key: "4.thrust_max", value: Num(6000.0), unit: "kN"),
            (key: "4.flange", value: Num(5.0), unit: "m"),
            (key: "plume_half_angle", value: Num(15.0), unit: "deg", note: "INVENTED: KEEP-OUT CONE ROUND THE AXIS"),
            (key: "plume_length", value: Num(0.035), unit: "m/sqrt(N)", note: "AS THE GAME DRAWS PLUMES"),
        ],
        requires: [
            (subject: "module.thrust", check: AtMost, param: "thrust_max", per: "size"),
            (subject: "module.flange", check: Equals, param: "flange", per: "size"),
        ],
        text: "THE HULL VENDOR CERTIFIES WHERE NOZZLES GO AND HOW HARD EACH MAY PUSH, SO THE VESSEL STAYS CONTROLLABLE ABOUT ITS CENTRE OF MASS LOADED OR EMPTY. NOTHING HERE MAKES IT SO: A BAD LAYOUT YAWS UNDER THRUST, AND ITS VENDOR'S NAME PAYS.",
        licence: Open,
    ),
    (
        key: "FSO/2.1/003",
        body: "body.fso",
        branch: "2.1",
        version: 1,
        title: "UTILITY SOCKET",
        scope: "WHERE WORK GEAR MOUNTS: SCOOPS, MINING ARMS, SENSORS, CLAMPS. MASS, LOAD, CLEARANCE, POWER, A HATCH OR NOT.",
        status: Published,
        refs: ["FSO/0.1/001", "FSO/6.1/001"],
        params: [
            (key: "1.mass_max", value: Num(1.0), unit: "t", note: "INVENTED"),
            (key: "1.load_max", value: Num(30.0), unit: "kN"),
            (key: "1.clearance", value: Text("2.0 X 2.0 X 1.5"), unit: "m"),
            (key: "1.power", value: Text("CLASS A"), unit: ""),
            (key: "2.mass_max", value: Num(4.0), unit: "t"),
            (key: "2.load_max", value: Num(120.0), unit: "kN"),
            (key: "2.clearance", value: Text("3.5 X 5.0 X 2.5"), unit: "m"),
            (key: "2.power", value: Text("CLASS B"), unit: ""),
            (key: "3.mass_max", value: Num(16.0), unit: "t"),
            (key: "3.load_max", value: Num(500.0), unit: "kN"),
            (key: "3.clearance", value: Text("6.0 X 9.0 X 4.0"), unit: "m"),
            (key: "3.power", value: Text("CLASS C"), unit: ""),
            (key: "hatch", value: Text("OPTIONAL: A RETRACTABLE COVER, THE MODULE LATCHED BENEATH"), unit: ""),
        ],
        requires: [
            (subject: "module.mass", check: AtMost, param: "mass_max", per: "size"),
            (subject: "module.load", check: AtMost, param: "load_max", per: "size"),
            (subject: "module.envelope", check: FitsWithin, param: "clearance", per: "size"),
            (subject: "module.power", check: Provides, param: "power", per: "size"),
        ],
        text: "THE GENERAL-PURPOSE SOCKET. CLEARANCE INCLUDES WHAT THE GEAR SWEEPS DEPLOYED (A MINING ARM'S REACH).",
        licence: Open,
    ),
    (
        key: "FSO/5.1/001",
        body: "body.fso",
        branch: "5.1",
        version: 1,
        title: "CARGO UNIT",
        scope: "THE STANDARD BOX GOODS TRAVEL IN: SIZE, GROSS MASS, CORNER FITTINGS, STACKING. NOT WHAT GOES IN IT.",
        status: Published,
        refs: ["FSO/0.1/001"],
        params: [
            (key: "length", value: Num(4.0), unit: "m", note: "INVENTED"),
            (key: "width", value: Num(2.5), unit: "m"),
            (key: "height", value: Num(2.5), unit: "m"),
            (key: "gross_max", value: Num(25.0), unit: "t"),
            (key: "tare", value: Num(2.0), unit: "t"),
            (key: "fittings", value: Text("ONE AT EACH OF THE 8 CORNERS"), unit: ""),
            (key: "stack_at_1g", value: Num(6.0), unit: "high"),
        ],
        requires: [
            (subject: "unit.gross", check: AtMost, param: "gross_max"),
        ],
        text: "ONE BOX, SO EVERY HOLD, CRANE AND RACK TAKES EVERY LOAD. HOLDS ARE RATED IN UNITS.",
        licence: Open,
    ),
    (
        key: "FSO/3.3/001",
        body: "body.fso",
        branch: "3.3",
        version: 1,
        title: "NAVIGATION LIGHTS",
        scope: "THE LIGHTS A VESSEL SHOWS SO OTHERS CAN TELL ITS ATTITUDE AND HEADING. NOT ITS FLOODLIGHTS.",
        status: Published,
        refs: ["FSO/0.1/001"],
        params: [
            (key: "port", value: Text("RED"), unit: ""),
            (key: "starboard", value: Text("GREEN"), unit: ""),
            (key: "stern_and_top", value: Text("WHITE"), unit: ""),
            (key: "strobe", value: Num(1.0), unit: "Hz", note: "WHITE, ANTI-COLLISION"),
        ],
        text: "THE OLD SEA'S RULE, KEPT: RED TO PORT, GREEN TO STARBOARD. SEE A RED ON YOUR LEFT AND A GREEN ON YOUR RIGHT AND IT'S COMING AT YOU.",
        licence: Open,
    ),
    (
        key: "FSO/3.2/001",
        body: "body.fso",
        branch: "3.2",
        version: 1,
        title: "HULL DATASHEET",
        scope: "WHAT A HULL VENDOR PUBLISHES SO OTHERS CAN BUILD TO THE HULL: ITS ENVELOPE, LIMITS AND SOCKETS. NOT HOW IT'S BUILT.",
        status: Published,
        refs: ["FSO/3.1/001", "FSO/2.1/001", "FSO/2.1/002", "FSO/2.1/003", "FSO/6.1/001"],
        params: [
            (key: "envelope", value: Text("SIZE CLASS; LENGTH, WIDTH, HEIGHT; DRY MASS; CENTRE OF MASS"), unit: ""),
            (key: "limits", value: Text("MAXIMUM THRUST LOAD; G RATING"), unit: ""),
            (key: "sockets", value: Text("EACH: STANDARD AND SIZE, FRAME, MAXIMUM MASS AND LOAD, CLEARANCE, SERVICES, HATCH"), unit: ""),
            (key: "thrust_layout", value: Text("EACH NOZZLE SOCKET'S AXIS AND ALLOWED THRUST"), unit: ""),
        ],
        requires: [
            (subject: "hull.datasheet", check: Provides, param: "envelope"),
            (subject: "hull.datasheet", check: Provides, param: "limits"),
            (subject: "hull.datasheet", check: Provides, param: "sockets"),
            (subject: "hull.datasheet", check: Provides, param: "thrust_layout"),
        ],
        text: "THE PAGE EVERY MODULE VENDOR READS FIRST. A HULL WITHOUT ONE CAN STILL FLY, BUT NOBODY BUILDS FOR IT.",
        licence: Open,
    ),
]
