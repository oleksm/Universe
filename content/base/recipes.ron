// Works: what they take and what they make, in tonnes a day. (Deuterium plants:
// only where there's water to process: an Earth-like world's seas, an outpost's
// ice. Wells: only
// an Earth-like world, oceans and rain, has water to draw and sell. An Earth-like
// world's own rain waters its fields.)
[
    (key: "recipe.mine", name: "MINE", takes: [], makes: [("market.ores", 40.0), ("market.minerals", 4.0)]),
    (key: "recipe.ice", name: "ICE WORKS", takes: [], makes: [("market.water", 300.0)]),
    (key: "recipe.wells", name: "WELLS", takes: [], makes: [("market.water", 60.0)]),
    (key: "recipe.farm", name: "FARMS", takes: [("market.chemicals", 2.0)], makes: [("market.food", 30.0), ("market.biologics", 0.6), ("market.textiles", 1.2)]),
    (key: "recipe.artisans", name: "ARTISANS", takes: [("market.textiles", 1.0), ("market.minerals", 0.5)], makes: [("market.luxuries", 1.5), ("market.art", 0.3)]),
    (key: "recipe.refinery", name: "REFINERY", takes: [("market.ores", 30.0)], makes: [("market.metals", 20.0), ("market.minerals", 2.0)]),
    (key: "recipe.smelter", name: "SMELTER", takes: [("market.ores", 10.0)], makes: [("market.metals", 6.0)]),
    (key: "recipe.chemicals", name: "CHEMICAL PLANT", takes: [("market.ores", 8.0), ("market.water", 10.0)], makes: [("market.chemicals", 24.0)]),
    // Deuterium from the sea or ice where it stands (a tonne in about 31,000 t of
    // water: a plant processing that much a day, not traded water).
    (key: "recipe.fuel_plant", name: "DEUTERIUM PLANT", takes: [], makes: [("market.fuel", 20.0)]),
    (key: "recipe.factory", name: "FACTORY", takes: [("market.metals", 10.0), ("market.chemicals", 3.0), ("market.electronics", 1.0)], makes: [("market.machinery", 6.0), ("market.tools", 4.0), ("market.robots", 1.0), ("market.weapons", 1.0)]),
    (key: "recipe.fab", name: "ELECTRONICS FAB", takes: [("market.metals", 1.0), ("market.minerals", 2.0), ("market.chemicals", 2.0)], makes: [("market.electronics", 3.0), ("market.computers", 1.0)]),
    (key: "recipe.pharma", name: "PHARMA PLANT", takes: [("market.chemicals", 2.0), ("market.biologics", 2.0)], makes: [("market.medicine", 4.0)]),
]
