// Hulls: what a ship is built as. Every number about how it flies follows
// from these and the physics (accelerations are thrusts over the mass as
// loaded). See docs/content.md.
[
    (
        key: "hull.cobra",
        name: "COBRA MK III",
        shape: "shape.cobra",
        // The multirole: a fair hold, lands anywhere, holds its own in a fight.
        // 30 m/s² (about 3 g) on the main engine at full load, 6 m/s² on the
        // thrusters, 25 m/s² of lift (enough to hover); a blunt 90 t ship that
        // falls at about 150 m/s through sea-level air.
        dry_mass: 60000.0,
        fuel_capacity: 30000.0,
        hold_capacity: 20000.0,
        // Its thrusters, on its shape's nozzles (thrust in N, opposite the
        // exhaust): the main drive, the translation thrusters, the belly lift.
        thrusters: [
            (nozzle: "nozzle_main_left", role: Main, thrust: 1.35e6),
            (nozzle: "nozzle_main_right", role: Main, thrust: 1.35e6),
            (nozzle: "nozzle_nose_left_up", role: Rcs, thrust: 1.35e5),
            (nozzle: "nozzle_nose_right_up", role: Rcs, thrust: 1.35e5),
            (nozzle: "nozzle_tail_left_up", role: Rcs, thrust: 1.35e5),
            (nozzle: "nozzle_tail_right_up", role: Rcs, thrust: 1.35e5),
            (nozzle: "nozzle_nose_left_side", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_nose_right_side", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_tail_left_side", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_tail_right_side", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_nose_left_fore", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_nose_right_fore", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_tail_left_aft", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_tail_right_aft", role: Rcs, thrust: 2.7e5),
            (nozzle: "nozzle_lift_nose_left", role: Lift, thrust: 5.625e5),
            (nozzle: "nozzle_lift_nose_right", role: Lift, thrust: 5.625e5),
            (nozzle: "nozzle_lift_tail_left", role: Lift, thrust: 5.625e5),
            (nozzle: "nozzle_lift_tail_right", role: Lift, thrust: 5.625e5),
        ],
        turn_rate: 1.0,
        roll_rate: 1.8,
        radius: 12.0,
        drag_area: 60.0,
        hull_strength: 20.0e6,
    ),
]
