    (key: "faction.reach", name: "FREE REACH ASSEMBLY", tag: "FRA", color: (1.0, 0.7, 0.3),
        note: "FRONTIER SETTLEMENTS GOVERNING THEMSELVES: LIGHT LAW, CHEAP LICENCES."),
    (key: "faction.tessaly", name: "TESSALY DIRECTORATE", tag: "TSD", color: (0.75, 0.45, 1.0),
        note: "AN INDUSTRIAL DIRECTORATE: ORDER, TARIFFS, ITS OWN YARDS."),
