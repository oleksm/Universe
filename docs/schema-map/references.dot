digraph registry {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, overlap=false, splines=true, nodesep=0.15, ranksep=1.2];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];
  "root:physical_object" [label="physical_object\n(common definition, 12 kinds)", shape=box3d, fillcolor="#222222", fontcolor="#ffffff"];
  "root:planet_context" [label="planet_context\n(common definition, 19 kinds)", shape=box3d, fillcolor="#222222", fontcolor="#ffffff"];
  subgraph "cluster_(root)" { label="(root)"; color="#4e79a7"; fontcolor="#4e79a7"; style="rounded";
    "org" [label="org", color="#4e79a7", penwidth=1, tooltip="organisation.schema.yaml"];
    "root" [label="root", color="#4e79a7", penwidth=1, tooltip="root.schema.yaml"];
  }
  subgraph "cluster_Celestial" { label="Celestial"; color="#f28e2b"; fontcolor="#f28e2b"; style="rounded";
