digraph registry {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, overlap=false, splines=true, nodesep=0.15, ranksep=1.2];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, fillcolor="#ffffff"];
  edge [fontname="Helvetica", fontsize=8];
  "root:physical_object" [label="physical_object\n(common definition, 12 kinds)", shape=box3d, fillcolor="#222222", fontcolor="#ffffff"];
  "root:planet_context" [label="planet_context\n(common definition, 19 kinds)", shape=box3d, fillcolor="#222222", fontcolor="#ffffff"];
  subgraph "cluster_(root)" { label="(root)"; color="#4e79a7"; fontcolor="#4e79a7"; style="rounded";
    "org" [label="org", color="#4e79a7", penwidth=1, tooltip="organisation.schema.yaml"];
    "root" [label="root", color="#4e79a7", penwidth=1, tooltip="root.schema.yaml"];
  }
  subgraph "cluster_Celestial" { label="Celestial"; color="#f28e2b"; fontcolor="#f28e2b"; style="rounded";
    "body" [label="body", color="#f28e2b", penwidth=2, tooltip="Celestial/schema/body.schema.yaml"];
    "deposit-type" [label="deposit-type", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/deposit-type.schema.yaml"];
    "ground-vocabulary" [label="ground-vocabulary", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/ground-vocabulary.schema.yaml"];
    "population" [label="population", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/population.schema.yaml"];
    "rock-class" [label="rock-class", color="#f28e2b", penwidth=2, tooltip="Celestial/schema/rock-class.schema.yaml"];
    "rock-unit" [label="rock-unit", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/rock-unit.schema.yaml"];
    "seeding" [label="seeding", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/seeding.schema.yaml"];
    "sight" [label="sight", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/sight.schema.yaml"];
    "system" [label="system", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/system.schema.yaml"];
    "vocabulary" [label="vocabulary", color="#f28e2b", penwidth=1, tooltip="Celestial/schema/vocabulary.schema.yaml"];
  }
  subgraph "cluster_Dogma" { label="Dogma"; color="#59a14f"; fontcolor="#59a14f"; style="rounded";
    "dogma" [label="dogma", color="#59a14f", penwidth=1, tooltip="Dogma/schema/section.schema.yaml"];
    "law" [label="law", color="#59a14f", penwidth=1, tooltip="Dogma/schema/law.schema.yaml"];
  }
  subgraph "cluster_Engine" { label="Engine"; color="#e15759"; fontcolor="#e15759"; style="rounded";
    "clock" [label="clock", color="#e15759", penwidth=1, tooltip="Engine/schema/clock.schema.yaml"];
  }
  subgraph "cluster_LocalAdministration" { label="LocalAdministration"; color="#76b7b2"; fontcolor="#76b7b2"; style="rounded";
    "facility" [label="facility", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/facility.schema.yaml"];
    "parcel" [label="parcel", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/parcel.schema.yaml"];
    "power-line" [label="power-line", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/power-line.schema.yaml"];
    "settlement" [label="settlement", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/settlement.schema.yaml"];
    "street" [label="street", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/street.schema.yaml"];
    "zone" [label="zone", color="#76b7b2", penwidth=1, tooltip="LocalAdministration/schema/zone.schema.yaml"];
  }
  subgraph "cluster_People" { label="People"; color="#edc948"; fontcolor="#edc948"; style="rounded";
    "need" [label="need", color="#edc948", penwidth=1, tooltip="People/schema/need.schema.yaml"];
    "profession" [label="profession", color="#edc948", penwidth=1, tooltip="People/schema/profession.schema.yaml"];
  }
  subgraph "cluster_PlanetLOD" { label="PlanetLOD"; color="#b07aa1"; fontcolor="#b07aa1"; style="rounded";
    "lod-model" [label="lod-model", color="#b07aa1", penwidth=2, tooltip="PlanetLOD/schema/lod-model.schema.yaml"];
  }
  subgraph "cluster_PlanetSim" { label="PlanetSim"; color="#ff9da7"; fontcolor="#ff9da7"; style="rounded";
    "planet-event" [label="planet-event", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-event.schema.yaml"];
    "planet-factor" [label="planet-factor", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-factor.schema.yaml"];
    "planet-feature" [label="planet-feature", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-feature.schema.yaml"];
    "planet-field" [label="planet-field", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-field.schema.yaml"];
    "planet-file" [label="planet-file", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-file.schema.yaml"];
    "planet-gate" [label="planet-gate", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-gate.schema.yaml"];
    "planet-handler" [label="planet-handler", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-handler.schema.yaml"];
    "planet-landmark" [label="planet-landmark", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-landmark.schema.yaml"];
    "planet-layer" [label="planet-layer", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-layer.schema.yaml"];
    "planet-level" [label="planet-level", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-level.schema.yaml"];
    "planet-line" [label="planet-line", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-line.schema.yaml"];
    "planet-measure" [label="planet-measure", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-measure.schema.yaml"];
    "planet-model" [label="planet-model", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-model.schema.yaml"];
    "planet-object" [label="planet-object", color="#ff9da7", penwidth=1, tooltip="PlanetSim/schema/planet-object.schema.yaml"];
    "planet-pattern" [label="planet-pattern", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-pattern.schema.yaml"];
    "planet-process" [label="planet-process", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-process.schema.yaml"];
    "planet-run-profile" [label="planet-run-profile", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-run-profile.schema.yaml"];
    "planet-target" [label="planet-target", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-target.schema.yaml"];
    "planet-view" [label="planet-view", color="#ff9da7", penwidth=2, tooltip="PlanetSim/schema/planet-view.schema.yaml"];
  }
  subgraph "cluster_SFO" { label="SFO"; color="#9c755f"; fontcolor="#9c755f"; style="rounded";
    "adapter" [label="adapter", color="#9c755f", penwidth=1, tooltip="SFO/schema/adapter.schema.yaml"];
    "arrangement" [label="arrangement", color="#9c755f", penwidth=1, tooltip="SFO/schema/arrangement.schema.yaml"];
    "assembly" [label="assembly", color="#9c755f", penwidth=2, tooltip="SFO/schema/assembly.schema.yaml"];
    "building" [label="building", color="#9c755f", penwidth=2, tooltip="SFO/schema/building.schema.yaml"];
    "connector" [label="connector", color="#9c755f", penwidth=2, tooltip="SFO/schema/connector.schema.yaml"];
    "element" [label="element", color="#9c755f", penwidth=1, tooltip="SFO/schema/element.schema.yaml"];
    "equipment" [label="equipment", color="#9c755f", penwidth=2, tooltip="SFO/schema/equipment.schema.yaml"];
    "gate" [label="gate", color="#9c755f", penwidth=1, tooltip="SFO/schema/gate.schema.yaml"];
    "good" [label="good", color="#9c755f", penwidth=2, tooltip="SFO/schema/good.schema.yaml"];
    "hull" [label="hull", color="#9c755f", penwidth=2, tooltip="SFO/schema/hull.schema.yaml"];
    "interface" [label="interface", color="#9c755f", penwidth=1, tooltip="SFO/schema/interface.schema.yaml"];
    "layout" [label="layout", color="#9c755f", penwidth=2, tooltip="SFO/schema/layout.schema.yaml"];
    "market" [label="market", color="#9c755f", penwidth=1, tooltip="SFO/schema/market.schema.yaml"];
    "material" [label="material", color="#9c755f", penwidth=1, tooltip="SFO/schema/material.schema.yaml"];
    "module" [label="module", color="#9c755f", penwidth=2, tooltip="SFO/schema/module.schema.yaml"];
    "mount" [label="mount", color="#9c755f", penwidth=1, tooltip="SFO/schema/mount.schema.yaml"];
    "package" [label="package", color="#9c755f", penwidth=1, tooltip="SFO/schema/package.schema.yaml"];
    "panel" [label="panel", color="#9c755f", penwidth=1, tooltip="SFO/schema/panel.schema.yaml"];
    "part" [label="part", color="#9c755f", penwidth=2, tooltip="SFO/schema/part.schema.yaml"];
    "plant-mount" [label="plant-mount", color="#9c755f", penwidth=1, tooltip="SFO/schema/plant-mount.schema.yaml"];
    "product" [label="product", color="#9c755f", penwidth=1, tooltip="SFO/schema/product.schema.yaml"];
    "rule" [label="rule", color="#9c755f", penwidth=1, tooltip="SFO/schema/rule.schema.yaml"];
    "run" [label="run", color="#9c755f", penwidth=1, tooltip="SFO/schema/run.schema.yaml"];
    "ship" [label="ship", color="#9c755f", penwidth=1, tooltip="SFO/schema/ship.schema.yaml"];
    "standard" [label="standard", color="#9c755f", penwidth=1, tooltip="SFO/schema/standard.schema.yaml"];
    "stock" [label="stock", color="#9c755f", penwidth=1, tooltip="SFO/schema/mill-stock.schema.yaml"];
    "structure" [label="structure", color="#9c755f", penwidth=1, tooltip="SFO/schema/structure.schema.yaml"];
    "template" [label="template", color="#9c755f", penwidth=1, tooltip="SFO/schema/template.schema.yaml"];
    "unit" [label="unit", color="#9c755f", penwidth=2, tooltip="SFO/schema/unit.schema.yaml"];
  }
  subgraph "cluster_SpaceshipBuilding" { label="SpaceshipBuilding"; color="#bab0ac"; fontcolor="#bab0ac"; style="rounded";
    "ship-artifact" [label="ship-artifact", color="#bab0ac", penwidth=1, tooltip="SpaceshipBuilding/schema/ship-artifact.schema.yaml"];
    "ship-check" [label="ship-check", color="#bab0ac", penwidth=1, tooltip="SpaceshipBuilding/schema/ship-check.schema.yaml"];
    "ship-decision" [label="ship-decision", color="#bab0ac", penwidth=1, tooltip="SpaceshipBuilding/schema/ship-decision.schema.yaml"];
    "ship-rule" [label="ship-rule", color="#bab0ac", penwidth=1, tooltip="SpaceshipBuilding/schema/ship-rule.schema.yaml"];
    "ship-stage" [label="ship-stage", color="#bab0ac", penwidth=1, tooltip="SpaceshipBuilding/schema/ship-stage.schema.yaml"];
  }
  "root:physical_object" -> "assembly" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "body" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "building" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "connector" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "equipment" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "good" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "hull" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "layout" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "module" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "part" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "rock-class" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:physical_object" -> "unit" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "lod-model" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-event" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-factor" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-feature" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-field" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-file" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-gate" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-handler" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-landmark" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-layer" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-level" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-line" [color="#222222", penwidth=1.6, arrowhead=onormal];
  "root:planet_context" -> "planet-measure" [color="#222222", penwidth=1.6, arrowhead=onormal];
