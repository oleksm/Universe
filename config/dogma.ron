// Dogma's laws: the physics every world runs on, whatever is built in
// it. Only nature's constants and the laws (real, or the invented hyper
// layer's) — no materials, devices, structures or designs: those are the
// world's (the world: `content/base/`, its own sheet `content/base/sheet.ron`
// and its `materials.ron`).
//
// The build turns this into `universe_physics::laws`; the dogma's claims are
// checked against it (`crates/world/tests/dogma.rs`); the report is
// `docs/physics-sheet.md` (`cargo run -p universe-world --example
// physics_sheet`). The charter: `docs/physics.md`.
//
// Kinds: Real (measured nature) · Invented (the hyper layer, by written rule) ·
// Simplified (an approximation of the real, to refine).
[
    (
        name: "Nature",
        note: "Constants of physics.",
        entries: [
            (name: "SPEED_OF_LIGHT", value: 299792458.0, unit: "m/s", kind: Real, note: "c: light, radio, radar, and every capture of an event."),
            (name: "STEFAN_BOLTZMANN", value: 5.670374e-8, unit: "W/(m²·K⁴)", kind: Real, note: "σ: how a body radiates heat: σ·ε·A·T⁴."),
            (name: "SOLAR_LUMINOSITY", value: 3.828e26, unit: "W", kind: Real, note: "The Sun's power: stars' luminosities are reckoned in it (1361 W/m² at 1 AU)."),
        ],
    ),
    (
        name: "Medium",
        note: "The hyper-medium: near masses it holds what moves in it under v_lim = K·d; far from them it's slack, s(d) = min(1, (K·d / v_open)²).",
        entries: [
            (name: "HYPER_RATE", value: 2.0, unit: "1/s", kind: Invented, note: "K: the limit per metre from the nearest surface. At 1 AU from a star, about 1,000 c."),
            (name: "INTERLOCK", value: 1000.0, unit: "m", kind: Invented, note: "Nothing moves in the medium within this of a body's highest ground."),
            (name: "V_OPEN_C", value: 1.0e6, unit: "c", kind: Invented, note: "Where the slack sets in (a few hundred AU from a star)."),
            (name: "STIFF_SLACK", value: 0.01, unit: "", kind: Invented, note: "A field forms only where the slack is below this (inside a system)."),
        ],
    ),
    (
        name: "Field",
        note: "A hyper-field's draw: P = m·s·(P_FLOOR + P_PUSH·(v/v*)³) / η, η the device's. Between stars, power per kg is the wall.",
        entries: [
            (name: "P_FLOOR", value: 1.0e4, unit: "W/kg", kind: Invented, note: "Holding a field in open space, per kg in it."),
            (name: "P_PUSH", value: 5.0e3, unit: "W/kg", kind: Invented, note: "Pushing it through the medium at the best speed; grows with the cube of speed."),
            (name: "V_BEST_C", value: 1000.0, unit: "c", kind: Invented, note: "v*: the speed the push is reckoned at."),
        ],
    ),
    (
        name: "Tube",
        note: "A gate or relay holds a tube of the medium open along its route (as long as the span; millions of c inside). Crossing in time t: E = eps·m·S·e^(t_nat/t), t_nat = T_LY·(S/1 ly)·(m/1 kg)^GAMMA. A tube of diameter d weighs as mu(d) = RHO·(d/1 m)^K: opening it is the same formula, holding it a share of that. See docs/world/hyperspace.md; tools/experiments/.",
        entries: [
            (name: "TUBE_T_LY", value: 0.2, unit: "s/ly", kind: Invented, note: "Natural crossing per light year for a 1 kg payload. Target: data crosses at 200 ms per ly; faster gets punishing."),
            (name: "TUBE_GAMMA", value: 0.3333333333, unit: "", kind: Invented, note: "Heavier is naturally slower, by the cube root of mass. Target: a 100 t ship under a minute through a 5 ly gate, a capital ship several minutes."),
            (name: "TUBE_EPS", value: 2.24e-12, unit: "J/(kg·m)", kind: Invented, note: "A crossing's energy scale. Target: a 100 t ship at natural speed through a 5 ly gate costs an S2 plant-hour."),
            (name: "TUBE_RHO", value: 406.0, unit: "kg", kind: Invented, note: "A 1 m tube's equivalent mass. Target: opening a 3 km, 5 ly gate costs a year of a 100 GW industry."),
            (name: "TUBE_K", value: 3.0, unit: "", kind: Invented, note: "A tube weighs by its diameter cubed. Target: opening a one-ship tube for one pass costs thousands of passes through a held gate; a gate pays at about 9 ships a day."),
            (name: "TUBE_HOLD", value: 2.592e8, unit: "s", kind: Invented, note: "Holding a tube costs its opening over this (100 months: 1% a month). Target: small next to opening, big in absolute terms: a lapse is ruinous."),
            (name: "TUBE_SETTLE", value: 3.0, unit: "s", kind: Invented, note: "After a throw a tube's flow settles this long before the next can be caught: the cadence data is batched at. Target: news crosses a relay link in 1-2 s."),
            (name: "MAX_TRANSIT_SPEED", value: 300.0, unit: "m/s", kind: Invented, note: "A ring catches what enters it slower than this; faster and the capture wrecks it."),
        ],
    ),
]
