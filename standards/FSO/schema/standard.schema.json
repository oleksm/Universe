{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standard",
  "description": "One FSO standard: a file NNNN-<slug>.yaml in standards/FSO/, its id FSO <NNNN>.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title"],
  "definitions": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "text": { "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
        "table": {
          "type": "object",
          "additionalProperties": false,
          "required": ["columns", "rows"],
          "properties": {
            "columns": { "type": "array", "items": { "type": "string" } },
            "rows": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } }
          }
        }
      }
    }
  },
  "properties": {
    "title": { "type": "string" },
    "purpose": { "type": "string", "description": "Why it exists, a paragraph." },
    "details": { "$ref": "#/definitions/block", "description": "Text and/or a table." },
    "sections": { "type": "array", "items": { "$ref": "#/definitions/block" } },
    "version": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["draft", "published", "superseded", "withdrawn"] },
    "scope": { "type": "string" },
    "topics": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "refs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z]{2,6} [0-9]+$" } },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "value"],
        "properties": {
          "key": { "type": "string" },
          "value": { "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }] },
          "unit": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "check", "param"],
        "properties": {
          "subject": { "type": "string" },
          "check": { "enum": ["at_most", "at_least", "equals", "fits_within", "provides"] },
          "param": { "type": "string" },
          "per": { "type": "string" }
        }
      }
    },
    "text": { "type": "string" },
    "licence": { "oneOf": [{ "const": "open" }, { "type": "object", "additionalProperties": false, "required": ["fee"], "properties": { "fee": { "type": "number", "minimum": 0 } } }] },
    "published": { "type": "number" }
  }
}
